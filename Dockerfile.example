###
# Dockerfile - Go Service Base Image
# Latest stable Go version with development tools
# 
# Build: docker build --build-arg GO_VERSION=1.25-alpine -t pc-go-service:latest .
###
ARG GO_VERSION=1.25-alpine

# Use Alpine Linux for smaller image size and security
# https://hub.docker.com/_/golang/
# Refer to https://blog.golang.org/docker for best practices
FROM golang:${GO_VERSION}

# Set environment variables
ENV GOPATH=/go \
    GOBIN=$GOPATH/bin \
    CGO_ENABLED=0

# Configure timezone to Asia/Jakarta
RUN apk add --no-cache tzdata ca-certificates curl git make bash \
    && rm -f /etc/localtime \
    && ln -s /usr/share/zoneinfo/Asia/Jakarta /etc/localtime \
    && cp /usr/share/zoneinfo/Asia/Jakarta /etc/localtime

# Add development tools for debugging and productivity
RUN apk add --no-cache \
    git \
    make \
    bash \
    curl \
    wget \
    vim \
    nano \
    less \
    openssh-client \
    postgresql-client \
    mysql-client

# Install Go tools for development
RUN go install github.com/air-verse/air@latest \
    && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest \
    && go install gotest.tools/gotestsum@latest

# Create non-root user for better security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Set working directory
WORKDIR /go/src

# Keep image layer caching friendly by not running services
# Services will be started via docker-compose or kubernetes

# Health check for container orchestration
# This will be overridden by service-specific implementations
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command (override in docker-compose or k8s)
CMD ["go", "version"]
